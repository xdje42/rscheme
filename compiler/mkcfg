#!/bin/sh
#
#  Build the configuration script that is loaded by the
#  compiler to get all the configuration settings, including
#  the version of RScheme being built and the pathnames
# FIXME: Is the version the version being built or the version doing the build?

echo "This is mkcfg in $(pwd)" >&2
echo "Args: $@" >&2
set -x

# Rscheme's convention is to write foo-dir, not foodir.
# However, we keep this script's arguments named foodir to match
# autoconf's convention.
# In the Rscheme build tree these values are top_srcdir and top_builddir.
# "dist" is short for "distribution": think "bootstrappable tarball".
dist_src_dir=$1
dist_build_dir=$2

# install_dir is where files go that are to be installed
# (installed -> think "make install")
# For the installed compiler pass INSTALL_DIR.
install_dir=$3

version=$4
build_id=$5

# These directories needn't exist yet if they're at --prefix.
# There's not much we can do except warn the user and hope they're
# absolute paths.
if test ! -d "$dist_src_dir"
then echo >&2 "Warning: dst_src_dir $dist_src_dir nonexistent"
else dist_src_dir=`cd $dist_src_dir ; pwd`
fi

if test ! -d "$dist_build_dir"
then echo >&2 "Warning: dist_build_dir $dist_build_dir nonexistent"
else dist_build_dir=`cd $dist_build_dir ; pwd`
fi

if test ! -d "$install_dir"
then echo >&2 "Warning: install_dir $install_dir nonexistent"
else install_dir=`cd $install_dir ; pwd`
fi

# The combined version+build-id string as a list of numbers, eg, 0 7 3 5
vlist=`echo "$version $build_id" | sed 's/[^0-9][^0-9]*/ /g'`

# Configure some build flags depending on what version of RScheme we are
# running. The current values are for version 0.7.3 and beyond. We do not
# support bootstrapping with earlier versions.

rsv=`$RS --version`

# Only Rscheme versions 0.7.3 and later are supported.
sis=new
rfp=t

cat <<EOF
,(use paths)

;; For consistency, keep this ordered the same as in mki.scm.
(define *dist-src-dir* (string->dir "$dist_src_dir"))
(define *dist-build-dir* (string->dir "$dist_build_dir"))
(define *install-dir* (string->dir "$install_dir"))
(define *rscheme-version* "$version")
(define *rscheme-build* "$build_id")
(define *rscheme-build-vlist* '($vlist))
(define *save-image-signature* '$sis)
(define *relative-file-paths* #$rfp)
EOF

## ie, mkcfg > buildcfg.scm
