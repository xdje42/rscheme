#! /bin/sh

img_dir="$1"
bcg_dir="$2"

if test ! -d "$img_dir"
then echo >&2 "Warning: img_dir $img_dir nonexistent"
else img_dir=`cd $img_dir ; /bin/pwd`
fi

if test ! -d "$bcg_dir"
then echo >&2 "Warning: bcg_dir $bcg_dir nonexistent"
else bcg_dir=`cd $bcg_dir ; /bin/pwd`
fi

# get absolute path to RS
#  (Pb: "which" itself is not 100% standard -- it appears to be a BSDism)

case "$RS" in
   "")  echo >&2 "mkrsc: RS is not set" ; exit 1 ;;
   /*)  ;;
   */*) RS=`pwd`/$RS ;;
   *)   RS=`which $RS` ;;
esac

cat <<EOF
#!/bin/sh

if test "\$1" = "-abt"
then abt=-abt
     shift
else abt=""
fi

case "\$1" in
  -precore) cb=start ; shift ;;
  -corelib) cb=+precore ; shift ;;
  -lowscm) cb=+core ; shift ;;
  *) cb=+low ;;
esac

set -x

exec $RS -q \$abt -image $img_dir/rsc.img \\
     -BC $bcg_dir/resource/compiler/bytecode/bcgen.scm \\
     -config-basis \$cb "\$@"
EOF
