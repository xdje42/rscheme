# INSTALL_DIR must be passed to us an argument to $(MAKE).
# It's value points to the install tree with the build inputs.
#
# FINAL_INSTALL_DIR defaults to INSTALL_DIR. It is compiled into "rs" as its
# (ultimate) installation directory.

@C@ifeq ($(INSTALL_DIR),)
@C@$(error INSTALL_DIR not defined)
@C@endif

top_srcdir=@top_srcdir@
srcdir=@top_srcdir@/handc/rshell
VPATH=@top_srcdir@/handc/rshell

FINAL_INSTALL_DIR=$(INSTALL_DIR)
XCFLAGS='-DINSTALL_DIR="$(FINAL_INSTALL_DIR)"'

include $(INSTALL_DIR)/resource/buildenv/preamble.mak

CFILES=shell.c
PRODUCT=rs

OFILES=$(CFILES:.c=.o)
LIB_RS=$(INSTALL_DIR)/lib/librs.a

$(PRODUCT): $(OFILES) $(LIB_RS)
	$(CC) $(CFLAGS) $(OFILES) -o $(PRODUCT) $(LDX_FLAGS)

clean::
	rm -f *.o $(PRODUCT)

distclean:: clean
	rm -f Makefile

depend::
	$(CC) $(CFLAGS) -MM -I. $(CFILES) > depends
